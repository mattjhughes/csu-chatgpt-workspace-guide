{
  "manifest_version": 3,
  "name": "CSU Workspace Overlay",
  "version": "0.6.0",
  "description": "CSU guidance for workspace settings, permissions and models, synchronized from GitHub.",
  "content_scripts": [
    {
      "matches": [
        "https://admin.openai.com/*"
      ],
      "js": [
        "baseline.js",
        "guidance-ui.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "guidance-ui.css",
        "overlay.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/csu-wordmark.png",
        "guidance-ui.css"
      ],
      "matches": [
        "https://admin.openai.com/*"
      ]
    }
  ],
  "permissions": [
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://raw.githubusercontent.com/*"
  ]
}
